{
  "name": "slopproof",
  "version": "0.2.0",
  "private": true,
  "description": "Full-stack web application template with a verifiable API contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=12.6.0 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "prepare": "lefthook install --reset-hooks-path",
    "bootstrap": "node scripts/bootstrap.ts",
    "check": "LEFTHOOK_EXCLUDE=${LEFTHOOK_EXCLUDE:-},repo-policy lefthook run pre-commit --all-files --no-auto-install",
    "check:changed": "node scripts/check-changed.ts",
    "check:caddy": "node scripts/caddy-validate.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsrs --noEmit",
    "deadcode": "fallow dead-code --fail-on-issues",
    "security:check": "fallow security --gate new --changed-since ${CHECK_BASE_REF:-HEAD} src",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "mail:up": "docker compose up -d --wait mailpit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "auth:check": "auth check schema --config src/server/auth.ts",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.ts",
    "features": "node scripts/features.ts",
    "openapi:generate": "node scripts/openapi.ts",
    "sdk:generate": "openapi-ts",
    "codegen": "pnpm openapi:generate && pnpm sdk:generate",
    "test": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:component": "vitest run --project component",
    "test:fast": "vitest run --project unit --project api --project component --coverage",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "verify:app": "node scripts/verify-app.ts",
    "verify:tla": "node scripts/tla.ts",
    "verify:ui-properties": "node scripts/ui-properties.ts",
    "verify:mutate": "node scripts/mutate.ts",
    "verify:bench": "vitest bench --run --project \"api (bench)\" tests/bench/hot-paths.bench.ts",
    "verify:load": "node scripts/load-test.ts --mode=smoke",
    "verify:soak": "node scripts/load-test.ts --mode=soak",
    "verify:dast": "node scripts/dast-smoke.ts",
    "verify:visual": "PW_VISUAL=1 playwright test tests/e2e/visual.spec.ts",
    "check:drift": "node scripts/check-drift.ts",
    "check:migrations": "squawk --config .config/squawk.toml drizzle/*.sql",
    "sbom:release": "pnpm sbom --sbom-format cyclonedx --sbom-type application --prod --out sbom/npm.cdx.json",
    "audit:check": "pnpm audit --audit-level high",
    "licenses:check": "node scripts/licenses.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "db:reset-test": "node --env-file-if-exists=.env scripts/test-db.ts",
    "ci:workflows": "node scripts/ci-jobs.ts workflows",
    "ci:static": "node scripts/ci-jobs.ts static",
    "ci:supply-chain": "node scripts/ci-jobs.ts supply-chain",
    "ci:secrets": "node scripts/ci-jobs.ts secrets",
    "ci:drift": "node scripts/ci-jobs.ts drift",
    "ci:build": "node scripts/ci-jobs.ts build",
    "ci:verify": "node scripts/ci-jobs.ts verify",
    "ci:lighthouse": "node scripts/ci-jobs.ts lighthouse",
    "ci:docker": "node scripts/ci-jobs.ts docker",
    "ci:local": "node scripts/ci-local.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.28",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "better-auth": "1.7.28",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.5",
    "get-nonce": "1.0.1",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "0.8.0",
    "@axe-core/playwright": "4.14.1",
    "@babel/core": "8.1.3",
    "@effect/tsgo": "0.73.4",
    "@effect/vitest": "4.1.5",
    "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
    "@nkzw/oxlint-config": "4.1.0",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.108.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@types/spdx-satisfies": "6.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.2",
    "@vitest/coverage-v8": "5.1.2",
    "auth": "1.7.28",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.3.2",
    "fallow": "3.48.0",
    "fast-check": "4.11.0",
    "lefthook": "2.2.3",
    "lighthouse": "13.6.0",
    "msw": "3.0.7",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-plugin-eslint": "1.95.0",
    "parse5": "8.1.1",
    "playwright": "1.64.1",
    "shadcn": "4.23.0",
    "spdx-satisfies": "6.0.1",
    "squawk-cli": "2.74.0",
    "tailwindcss": "4.3.5",
    "tinyexec": "1.4.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "vitest-browser-react": "2.3.0"
  },
  "intent": {
    "skills": [
      "@tanstack/*",
      "fallow"
    ]
  }
}
